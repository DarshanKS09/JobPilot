{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "1.0.0",
  "description": "Detect likely job submissions and save them to JobPilot.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JobPilot",
    "default_popup": "popup.html"
  }
}
